# --- Database -----------------------------------------------------------------
EVENTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/events_db
# Integration tests create/drop tables here - never point it at a real database.
TEST_EVENTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/events_test
# Open every connection read-only (Postgres rejects writes; jobs and CRM actions are disabled).
EVENTS_DATABASE_READ_ONLY=false

# --- Auth ---------------------------------------------------------------------
# Shared secret with betterapply (its EVENTS_API_KEY). Required for /api/logs and
# for server-only events on /api/events.
INGEST_API_KEY=change-me-ingest
# Protects every other /api/* route (read APIs, internal job triggers).
ADMIN_API_KEY=change-me-admin
# Comma-separated origins allowed to send keyless browser events.
ALLOWED_ORIGINS=http://localhost:3000

# --- Time ---------------------------------------------------------------------
# Everything is stored in UTC. "Today" and every business date use this zone.
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Jobs ---------------------------------------------------------------------
JOBS_ENABLED=true
ONLINE_WINDOW_SECONDS=300
SESSION_IDLE_MINUTES=30
AUTO_ASSIGN_LEADS=false

# --- User details ------------------------------------------------------------
# Product database holding the "User" table (name, email, phone, plan). Joined
# on "User"."clerkId" = users.user_id. Always opened read-only. Optional.
USER_DETAIL_DB=
# Mask email and phone in every list (SOP 17.2). false = show them in full.
PII_MASKING=true

# --- Dashboard sign-in ---------------------------------------------------------
# Single shared login. If any of the three is missing, every page stays locked.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
